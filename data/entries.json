    {
      "id": "nshm",
      "title": { "en": "Installable nshm", "zh": "可安装 nshm" },
      "emoji": "🧩",
      "description": {
        "en": "Modules verified with `nsh add` in a clean scratch app on nsh 0.7.1 (from crates.io, `github:owner/repo`, or Git URL).",
        "zh": "以下模块均已在 nsh 0.7.1 全新临时应用中实测通过 `nsh add` 安装验证（涵盖 crates.io、`github:owner/repo` 与 Git URL）。"
      }
    },
    {
      "id": "framework",
      "title": { "en": "Framework & Official Crates", "zh": "框架与官方 Crate" },
      "emoji": "🧱",
      "description": {
        "en": "Official runtime, tooling, and platform backend crates maintained in `longbridge/nsh`; managed automatically by `nsh` or added in Rust via `cargo add` rather than `nsh add`.",
        "zh": "由 `longbridge/nsh` 维护的官方运行时、工具链与平台后端 crate，由 `nsh` 自动管理或在 Rust 项目中以 `cargo add` 引入，而非 `nsh add` 模块。"
      }
    },
    {
