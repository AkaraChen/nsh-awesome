    {
      "id": "nsh-widgets",
      "name": "nsh-widgets",
      "section": "nshm",
      "category": "ui",
      "kind": "hybrid-nshm",
      "installable": true,
      "sourceType": "git",
      "installCommand": "nsh add https://github.com/SuperNSH/widgets.git --rev master",
      "version": "0.4.1",
      "nshVersion": "^0.7.1",
      "description": {
        "en": "Cross-platform home-screen widgets and Live Activities using one shared Widget Tree IR rendered natively via WidgetKit, RemoteViews, Plasma, and GNOME.",
        "zh": "跨平台桌面/锁屏小组件与 Live Activities 模块，通过统一 Widget Tree IR 在 WidgetKit、Android RemoteViews、KDE Plasma 与 GNOME 原生渲染。"
      },
      "sourceUrl": "https://github.com/SuperNSH/widgets",
      "cratesUrl": "https://crates.io/crates/nsh-widgets",
      "homepage": null,
      "platforms": ["iOS", "macOS", "Android", "Linux"],
      "license": "MIT",
      "updatedAt": "2026-11-26",
      "notes": {
        "en": "Use the Git URL `--rev master` on NSH 0.7.1; crates.io 0.4.1 and tag v0.4.1 still pin `nsh: ^0.6`.",
        "zh": "NSH 0.7.1 需通过 Git URL `--rev master` 安装；crates.io 0.4.1 与 v0.4.1 tag 仍锁定 `nsh: ^0.6`。"
      }
    },
    {
      "id": "nsh-icon",
      "name": "nsh-icon",
      "section": "nshm",
      "category": "icons",
      "kind": "rust-nshm",
      "installable": true,
      "sourceType": "crates.io",
      "installCommand": "nsh add nsh-icon",
      "version": "0.2.2",
      "nshVersion": ">=0.7",
      "description": {
        "en": "Tree-shaken vector icon renderer (`<Icon>` and `icon()`) paired with five installable icon-set crates (Lucide, Heroicons, Tabler, Phosphor, Remix).",
        "zh": "支持按需裁剪的矢量图标渲染器（`<Icon>` 与 `icon()`），配套 5 个可单独安装的图标集 crate（Lucide、Heroicons、Tabler、Phosphor、Remix）。"
      },
      "sourceUrl": "https://github.com/huacnlee/nsh-icon",
      "cratesUrl": "https://crates.io/crates/nsh-icon",
      "homepage": null,
      "platforms": ["macOS", "iOS", "Android", "Windows", "Linux", "Web"],
      "license": "Apache-2.0",
      "updatedAt": "2026-11-25",
      "notes": {
        "en": "Install companion icon packs alongside it, e.g. `nsh add nsh-icon-lucide`, `nsh-icon-heroicons`, `nsh-icon-tabler`, `nsh-icon-phosphor`, `nsh-icon-remix`.",
        "zh": "配合具体图标包使用，例如 `nsh add nsh-icon-lucide`（另有 heroicons、tabler、phosphor、remix 共 5 个子包）。"
      }
    },
    {
      "id": "supernsh-icons",
      "name": "supernsh-icons",
      "section": "nshm",
      "category": "icons",
      "kind": "hybrid-nshm",
      "installable": true,
      "sourceType": "crates.io",
      "installCommand": "nsh add supernsh-icons",
      "version": "0.2.0",
      "nshVersion": ">=0.7",
      "description": {
        "en": "Typed SVG and font-glyph icon library covering 260 Iconify sets (~465,000 icons) with 35 installable companion set crates.",
        "zh": "基于 Iconify 的强类型 SVG 与字体图标库，覆盖 260 套（约 46.5 万个）图标，并拆分为 35 个可按需安装的 `supernsh-icons-*` 子 crate。"
      },
      "sourceUrl": "https://github.com/SuperNSH/icons",
      "cratesUrl": "https://crates.io/crates/supernsh-icons",
      "homepage": "https://supernsh.github.io/icons/",
      "platforms": ["macOS", "iOS", "Android", "Windows", "Linux", "Web"],
      "license": "MIT",
      "updatedAt": "2026-11-25",
      "notes": {
        "en": "Companion crates `supernsh-icons-lucide`, `supernsh-icons-mdi`, `supernsh-icons-ph`, etc. are grouped under this entry rather than listed 35 times.",
        "zh": "35 个 `supernsh-icons-*` 图标集子 crate 均归并在此条目下，避免清单被重复子包刷屏。"
      }
    },
