    {
      "id": "nsh-extra",
      "name": "nsh-extra",
      "section": "nshm",
      "category": "official",
      "kind": "rust-nshm",
      "installable": true,
      "sourceType": "crates.io",
      "installCommand": "nsh add nsh-extra --features camera",
      "version": "0.7.1",
      "nshVersion": "0.7.1",
      "description": {
        "en": "Official optional device modules for NSH apps gated by Cargo features: camera, location, photos, push, and speech.",
        "zh": "NSH 官方按 Cargo feature 按需开启的设备能力模块集合，涵盖 camera、location、photos、push 与 speech。"
      },
      "sourceUrl": "https://github.com/longbridge/nsh/tree/main/crates/nsh-extra",
      "cratesUrl": "https://crates.io/crates/nsh-extra",
      "homepage": "https://nsh.dev/docs/nshm#nsh-extra",
      "platforms": ["iOS", "Android", "macOS", "Windows", "Web"],
      "license": "Apache-2.0",
      "updatedAt": "2026-11-25",
      "notes": {
        "en": "Per-feature platform availability: camera (iOS, Android), location (macOS, iOS, Web), photos (iOS), push (iOS, Android), speech (macOS, iOS, Android, Windows, Web).",
        "zh": "各 feature 平台支持不同：camera（iOS、Android）、location（macOS、iOS、Web）、photos（iOS）、push（iOS、Android）、speech（macOS、iOS、Android、Windows、Web）。"
      }
    },
    {
      "id": "nsh-omarchy",
      "name": "nsh-omarchy",
      "section": "nshm",
      "category": "ui",
      "kind": "rust-nshm",
      "installable": true,
      "sourceType": "crates.io",
      "installCommand": "nsh add nsh-omarchy",
      "version": "0.2.0",
      "nshVersion": ">=0.7",
      "description": {
        "en": "Omarchy-themed UI component set built on nsh-base with live system theme following, forms, overlays, tables, and charts for Rust and TSX.",
        "zh": "基于 nsh-base 的 Omarchy 风格原生 UI 组件库，支持自动跟随系统主题切换，在 Rust 与 TSX 中提供表单、浮层、表格与图表。"
      },
      "sourceUrl": "https://github.com/huacnlee/nsh-omarchy",
      "cratesUrl": "https://crates.io/crates/nsh-omarchy",
      "homepage": "https://huacnlee.github.io/nsh-omarchy/",
      "platforms": ["macOS", "Linux", "Windows", "iOS", "Android", "Web"],
      "license": "MIT",
      "updatedAt": "2026-11-25",
      "notes": {
        "en": "Falls back to Tokyo Night (dark) or Flexoki Light when Omarchy theme files are absent.",
        "zh": "未检测到 Omarchy 主题配置时自动回退为 Tokyo Night（深色）或 Flexoki Light（浅色）。"
      }
    },
    {
