{
  "name": "nsh-awesome",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Curated awesome list, searchable static directory, discovery script, and machine-readable index.json for Native Shell (NSH) modules (nshm).",
  "repository": "https://github.com/AkaraChen/nsh-awesome",
