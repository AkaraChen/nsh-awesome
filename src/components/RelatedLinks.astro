---
import InlineCode from './InlineCode.astro';
import { withBase } from '../i18n/ui';

export interface RelatedItem {
  path: string;
  label?: string;
  title?: string;
  reason?: string;
  summary?: string;
}

interface Props {
  id?: string;
  items: RelatedItem[];
  heading: string;
  headingLevel?: 2 | 3;
}

const { id, items = [], heading, headingLevel = 2 } = Astro.props;
---

{items.length > 0 && (
  <section class="content-band" id={id}>
    {headingLevel === 3 ? <h3>{heading}</h3> : <h2>{heading}</h2>}
    <div class="related-grid">
      {items.map((item) => (
        <article class="related-card">
          {headingLevel >= 3 ? (
            <h4 class="related-card__title">
              <a href={withBase(item.path)}>
                <InlineCode text={item.label || item.title || ''} />
              </a>
            </h4>
          ) : (
            <h3 class="related-card__title">
              <a href={withBase(item.path)}>
                <InlineCode text={item.label || item.title || ''} />
              </a>
            </h3>
          )}
          <p class="related-card__desc">
            <InlineCode text={item.reason || item.summary || ''} />
          </p>
        </article>
      ))}
    </div>
  </section>
)}
