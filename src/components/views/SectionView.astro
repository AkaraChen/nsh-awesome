---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import InlineCode from '../InlineCode.astro';
import EntryCard from '../EntryCard.astro';
import DataTable from '../DataTable.astro';
import Callout from '../Callout.astro';
import RelatedLinks from '../RelatedLinks.astro';
import { UI, getLocalePath, withBase, type Locale } from '../../i18n/ui';
import {
  buildInstallableLinkMap,
  getCatalogBundle,
  getPageContentEntry,
} from '../../lib/catalog';
import { buildSectionSchema } from '../../../scripts/lib/seo-schema.mjs';

interface Props {
  lang: Locale;
  slug: 'nshm' | 'framework' | 'templates' | 'guides';
}

const { lang, slug } = Astro.props;
const t = UI[lang];
const { data, routes } = await getCatalogBundle();
const pageEntry = await getPageContentEntry(lang, slug);
if (pageEntry.data.pageType !== 'section') {
  throw new Error(`Expected section pageType for ${lang}/${slug}`);
}
const pageData = pageEntry.data;
const { Content } = await render(pageEntry);

const route = routes.find((r) => r.key === `section:${slug}` && r.lang === lang)!;
const secMeta = data.sections.find((s) => s.id === pageData.entriesSection);
const secEntries = data.entries.filter((e) => e.section === pageData.entriesSection);
const categories = data.categories.filter(
  (c) => c.section === pageData.entriesSection && secEntries.some((e) => e.category === c.id),
);
const linkMap = buildInstallableLinkMap(data.entries, lang);
const installableCount = data.entries.filter((e) => e.installable).length;
const siteUrl = data.siteUrl || 'https://nsh-awesome.vercel.app/';
const homeHref = getLocalePath(lang, '');

const breadcrumbs = [
  { label: t.homeLabel, href: homeHref },
  { label: secMeta?.title?.[lang] || slug },
];

const jsonLdGraph = buildSectionSchema({
  siteUrl,
  lang,
  section: secMeta || pageData.entriesSection,
  entries: secEntries,
  pageUrl: route.url,
  title: route.title,
  description: route.description,
  updatedAt: route.lastmod,
});
---

<BaseLayout
  lang={lang}
  title={route.title}
  description={route.description}
  canonicalUrl={route.url}
  enUrl={route.enUrl}
  zhUrl={route.zhUrl}
  altPath={route.altPath}
  mdUrl={route.mdUrl}
  socialType="website"
  modifiedTime={route.lastmod}
  jsonLdGraph={jsonLdGraph}
  activeNav={slug}
  nshmCount={installableCount}
  nshVerifiedVersion={data.nshVerifiedVersion}
  siteUrl={siteUrl}
>
  <section class="hero hero--compact">
    <div class="container hero__copy">
      <Breadcrumbs items={breadcrumbs} lang={lang} />
      <h1>{pageData.h1}</h1>
      <p class="hero__desc">
        <InlineCode text={pageData.lead} />
      </p>
      <div class="action-row">
        <a class="pill-link" href={withBase(route.mdPath)}>
          {t.markdownEdition}
        </a>
        <a class="pill-link" href={homeHref}>
          {t.backHome}
        </a>
      </div>
    </div>
  </section>

  <div class="container page-body">
    <section class="content-band">
      <h2>{t.sectionOverview}</h2>
      <div class="md-prose">
        <Content />
      </div>
    </section>

    <Callout
      heading={pageData.technicalCallout.heading}
      body={pageData.technicalCallout.body}
      variant={slug === 'framework' ? 'warn' : 'info'}
    />

    <DataTable
      heading={pageData.comparisonTable.heading}
      intro={pageData.comparisonTable.intro}
      columns={pageData.comparisonTable.columns}
      rows={pageData.comparisonTable.rows}
      linkModuleMap={slug === 'nshm' ? linkMap : null}
    />

    {
      categories.map((cat) => {
        const items = secEntries.filter((e) => e.category === cat.id);
        return (
          <section class="section-block" id={`cat-${cat.id}`}>
            <div class="section-head">
              <h2>{cat.title[lang]}</h2>
              <span class="section-count">{items.length}</span>
            </div>
            <div class="grid">
              {items.map((e) => (
                <EntryCard entry={e} lang={lang} />
              ))}
            </div>
          </section>
        );
      })
    }

    <section class="content-band">
      <h2>{pageData.selectionAdvice.heading}</h2>
      <div class="two-col">
        {
          pageData.selectionAdvice.items.map((item) => (
            <article class="subcard">
              <h3 class="card__title">
                <InlineCode text={item.title} />
              </h3>
              <p class="card__desc">
                <InlineCode text={item.body} />
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <RelatedLinks items={pageData.relatedLinks} heading={t.relatedHubs} />
  </div>
</BaseLayout>
